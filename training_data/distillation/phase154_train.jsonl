{"created_at":"2026-08-18T22:54:45Z","domain":"backend","execution_evidence":{"record_index":1,"reviewed":true,"seed":true},"format":"fodci.teacher_student_example","metadata":{},"prompt":"What is a unit test in Python?","quality_status":"accepted","record_id":"sha256:d009f13917b8d5da18333dab74c9ad969eaab3c2f8e81d9bc2a7d073778641ed","redaction_status":"clean","response":"A unit test checks one small unit of behavior in isolation. It should replace external dependencies with controlled test doubles.","schema_version":"1.0","source":"teacher_interaction","split":"train","teacher_model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","teacher_model_fingerprint":"sha256:8888888888888888888888888888888888888888888888888888888888888888","training_eligible":true,"user_approved":true,"verification_status":"human_approved"}
{"created_at":"2026-08-18T22:54:45Z","domain":"backend","execution_evidence":{"record_index":2,"reviewed":true,"seed":true},"format":"fodci.teacher_student_example","metadata":{},"prompt":"How should passwords be stored in a backend?","quality_status":"accepted","record_id":"sha256:fe9ca92fbf08dbc74c997ef35c5e3c3430d56fdb89ef43fec0c1d51dc4763a43","redaction_status":"clean","response":"Store passwords with a slow password hashing algorithm such as Argon2id or bcrypt. Never store plaintext passwords or reversible encryption.","schema_version":"1.0","source":"teacher_interaction","split":"train","teacher_model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","teacher_model_fingerprint":"sha256:8888888888888888888888888888888888888888888888888888888888888888","training_eligible":true,"user_approved":true,"verification_status":"human_approved"}
{"created_at":"2026-08-18T22:54:45Z","domain":"backend","execution_evidence":{"record_index":3,"reviewed":true,"seed":true},"format":"fodci.teacher_student_example","metadata":{},"prompt":"How should a PostgreSQL backend avoid SQL injection?","quality_status":"accepted","record_id":"sha256:eb2e1c13a37fd1456e1475c7228f8b1969dc700bd4f494fbdf66a874b54aa8d2","redaction_status":"clean","response":"Use parameterized queries so SQL structure stays separate from user data. Do not build SQL by concatenating untrusted input.","schema_version":"1.0","source":"teacher_interaction","split":"train","teacher_model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","teacher_model_fingerprint":"sha256:8888888888888888888888888888888888888888888888888888888888888888","training_eligible":true,"user_approved":true,"verification_status":"human_approved"}
